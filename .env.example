GROQ_API_KEY=                 # free at console.groq.com; empty = rules engine only
LLM_PROVIDER=groq             # groq | gemini
LLM_MODEL=                    # optional override (default openai/gpt-oss-120b on Groq)
API_KEY=change-me             # callers send this as X-API-Key
DEMO_MODE=false               # true = public dashboard with sample data, uploads disabled
AS_OF_DATE=                   # e.g. 2026-11-13 to freeze "today" for the demo; empty = real today
BUSINESS_NAME=Kola Foods Distribution Ltd
DATABASE_PATH=data/paymatch.db
